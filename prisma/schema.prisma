generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CITIZEN
  AUTHORITY
}

enum Tier {
  CITIZEN
  CONTRIBUTOR
  GUARDIAN
  AMBASSADOR
}

enum Category {
  POTHOLES
  DRAINAGE
  WATERLOGGING
  STREETLIGHTS
  SIDEWALKS
  FOOTPATH
  TRAFFIC_SIGNS
  ROAD_CUT
  TREE_FALL
  GRAFFITI
  TRASH
  OTHER
}

enum Status {
  OPEN
  CONFIRMED
  ASSIGNED
  IN_PROGRESS
  CLAIMED_FIXED
  VERIFIED_FIXED
  DISPUTED
  REJECTED
  REOPENED_IN_WARRANTY
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum Band {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum EvidenceRole {
  REPORT
  CONFIRM
  CLAIM_FIX
  VERIFY
  AUDIT
}

enum AuditKind {
  CLAIM_CHECK
  DURABILITY
  CONTROL
}

enum AuditTaskStatus {
  OPEN
  DONE
  EXPIRED
}

enum AuditObserved {
  INTACT
  DAMAGED
  CANNOT_SEE
}

enum DayType {
  WEEKDAY
  WEEKEND
}

enum ProfileSource {
  TOMTOM_HISTORIC
  LIVE_SAMPLE
  ESTIMATED
}

enum DeteriorationRisk {
  LOW
  MED
  HIGH
}

enum SegmentEventType {
  REPORTED
  VERIFIED_FIX
  RESURFACED
  ROAD_CUT
  WATERLOGGED
  RECURRENCE
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  role           Role            @default(CITIZEN)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  passwordHash   String
  name           String?
  citizenProfile CitizenProfile?
  comments       Comment[]
  auditTasks     AuditTask[]
  auditVotes     AuditVote[]
  auditorScore   AuditorScore?
}

model CitizenProfile {
  id         String     @id @default(cuid())
  userId     String     @unique
  tier       Tier       @default(CITIZEN)
  phone      String?
  reputation Int        @default(0)
  verified   Boolean    @default(false)
  user       User       @relation(fields: [userId], references: [id])
  pointLogs  PointLog[]
}

model Agency {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String
  slaHours Int     @default(72)
  issues   Issue[]
}

model Ward {
  id   String                                      @id @default(cuid())
  code String                                      @unique
  name String
  geom Unsupported("geography(MultiPolygon,4326)")?
}

model RoadSegment {
  id                   String                                    @id @default(cuid())
  osmWayId             BigInt
  name                 String?
  roadClass            String
  lanes                Int?
  busesPerHour         Float                                     @default(0)
  pedestrianEstimate   Float                                     @default(0)
  nearSchoolOrHospital Boolean                                   @default(false)
  soleAccess           Boolean                                   @default(false)
  wardId               String?
  tracked              Boolean                                   @default(false)
  isHotspot            Boolean                                   @default(false)
  geom                 Unsupported("geography(LineString,4326)")?
  issues               Issue[]
  events               SegmentEvent[]
  samples              TrafficSample[]
  trafficProfiles      PlaceTrafficProfile[]
}

model Issue {
  id                   String                              @id @default(cuid())
  category             Category
  status               Status                              @default(OPEN)
  lat                  Float
  lng                  Float
  geom                 Unsupported("geography(Point,4326)")?
  address              String?
  wardId               String?
  segmentId            String?
  agencyId             String?
  handoffCount         Int                                 @default(0)
  sizeClass            String?
  lanePosition         String?
  blockedShare         String                              @default("none")
  hazardFlag           String?
  priority             Float                               @default(0)
  band                 Band                                @default(LOW)
  piBreakdown          Json?
  piText               String?
  bandOverride         Band?
  bandOverrideNote     String?
  recurrenceOf         String?
  needsDuplicateReview Boolean                             @default(false)
  slaDueAt             DateTime
  slaBreached          Boolean                             @default(false)
  isSeed               Boolean                             @default(false)
  repairClaimedAt      DateTime?
  warrantyUntil        DateTime?
  contractorName       String?
  tenderId             String?
  lifespanDays         Int?
  liabilityClauseRef   String?
  deteriorationRisk    DeteriorationRisk?
  deteriorationScore   Int?
  expectedDaysToWorsen Int?
  isHotspot            Boolean                             @default(false)
  deteriorationDrivers Json?
  aiAssessedAt         DateTime?
  aiInputHash          String?
  createdAt            DateTime                            @default(now())
  updatedAt            DateTime                            @updatedAt
  reports              Report[]
  verifications        Verification[]
  actions              ActionLog[]
  comments             Comment[]
  assignments          Assignment[]
  trafficSamples       TrafficSample[]
  trafficProfiles      PlaceTrafficProfile[]
  auditTasks           AuditTask[]
  segment              RoadSegment?                        @relation(fields: [segmentId], references: [id])
  agency               Agency?                             @relation(fields: [agencyId], references: [id])
}

model Report {
  id           String       @id @default(cuid())
  issueId      String
  userId       String
  role         EvidenceRole
  photoUrl     String
  photoSha256  String
  signature    String
  deviceKeyId  String?
  nonce        String?      @unique
  offline      Boolean      @default(false)
  legacy       Boolean      @default(false)
  lat          Float
  lng          Float
  gpsAccuracyM Float
  capturedAt   DateTime
  note         String?
  noteLang     String?
  noteEnglish  String?
  headingDeg   Float?
  aiTriage     Json?
  isSeed       Boolean      @default(false)
  createdAt    DateTime     @default(now())
  issue        Issue        @relation(fields: [issueId], references: [id])
  auditTasks   AuditTask[]
}

model DeviceKey {
  id        String    @id @default(cuid())
  userId    String
  publicJwk Json
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

model EvidenceNonce {
  id        String    @id @default(cuid())
  userId    String
  value     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
}

model ActionLog {
  id         String   @id @default(cuid())
  issueId    String
  actorId    String
  action     String
  note       String?
  reportId   String?
  fromStatus Status?
  toStatus   Status?
  createdAt  DateTime @default(now())
  issue      Issue    @relation(fields: [issueId], references: [id])
}

model Verification {
  id         String   @id @default(cuid())
  issueId    String
  verifierId String
  reportId   String
  verdict    String
  weight     Float
  createdAt  DateTime @default(now())
  issue      Issue    @relation(fields: [issueId], references: [id])

  @@unique([issueId, verifierId])
}

model SegmentEvent {
  id         String           @id @default(cuid())
  segmentId  String
  type       SegmentEventType
  agency     String?
  contractor String?
  workOrder  String?
  source     String
  sourceId   String?
  occurredAt DateTime
  isSeed     Boolean          @default(false)
  segment    RoadSegment      @relation(fields: [segmentId], references: [id])
}

model TrafficSample {
  id            String       @id @default(cuid())
  issueId       String?
  segmentId     String?
  sampledAt     DateTime
  hourOfWeek    Int          @default(0)
  currentSpeed  Float
  freeFlowSpeed Float
  congestionR   Float        @default(0)
  frc           String?
  confidence    Float?
  isSeed        Boolean      @default(false)
  issue         Issue?       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  segment       RoadSegment? @relation(fields: [segmentId], references: [id])

  @@index([issueId, hourOfWeek])
  @@index([issueId, sampledAt])
  @@index([segmentId, sampledAt])
  @@index([sampledAt])
}

model PlaceTrafficProfile {
  id          String        @id @default(cuid())
  issueId     String?
  segmentId   String?
  direction   String?       @default("BOTH")
  dayType     DayType
  hour        Int
  delayRatio  Float
  source      ProfileSource @default(ESTIMATED)
  fetchedAt   DateTime      @default(now())

  issue       Issue?        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  segment     RoadSegment?  @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  @@index([issueId, dayType, hour])
  @@index([segmentId, dayType, hour])
  @@index([fetchedAt])
}

model WeatherForecast {
  id         String   @id @default(cuid())
  pointKey   String
  hour       DateTime
  precipMm   Float
  precipProb Float
  tempC      Float
  fetchedAt  DateTime @default(now())

  @@unique([pointKey, hour])
}

model Signal {
  id         String                                @id @default(cuid())
  source     String
  sourceUrl  String                                @unique
  sourceText String
  placeText  String
  category   Category
  lat        Float?
  lng        Float?
  geom       Unsupported("geography(Point,4326)")?
  expiresAt  DateTime
  issueId    String?
  createdAt  DateTime                              @default(now())
}

model AiJob {
  id        String   @id @default(cuid())
  feature   String
  targetId  String
  status    String   @default("queued")
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([status, feature])
}

model AiRun {
  id         String   @id @default(cuid())
  feature    String
  model      String
  promptVer  String
  inputHash  String
  output     Json
  valid      Boolean
  failReason String?
  costUsd    Float    @default(0)
  createdAt  DateTime @default(now())

  @@index([feature, inputHash])
}

model SavedRoute {
  id        String   @id @default(cuid())
  userId    String
  name      String
  vehicle   String
  geomJson  Json
  createdAt DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())
}

model Personnel {
  id          String       @id @default(cuid())
  name        String
  role        String
  contact     String
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assignments Assignment[]
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  userId    String
  issueId   String
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model PointLog {
  id        String         @id @default(cuid())
  points    Int
  reason    String
  citizenId String
  createdAt DateTime       @default(now())
  citizen   CitizenProfile @relation(fields: [citizenId], references: [id])
}

model Assignment {
  id          String           @id @default(cuid())
  issueId     String
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  status      AssignmentStatus @default(PENDING)
  personnelId String
  personnel   Personnel        @relation(fields: [personnelId], references: [id])
  issue       Issue            @relation(fields: [issueId], references: [id])
}

model ApiUsage {
  id        String   @id @default(cuid())
  provider  String
  month     String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, month])
  @@index([provider, month])
}

model AuditTask {
  id                  String          @id @default(cuid())
  issueId             String
  assigneeId          String?
  kind                AuditKind
  dueAt               DateTime
  challengeBearingDeg Int             // 0-359
  challengeNonce      String
  status              AuditTaskStatus @default(OPEN)
  createdAt           DateTime        @default(now())
  completedAt         DateTime?
  reportId            String?
  isSeed              Boolean         @default(false)

  issue               Issue           @relation(fields: [issueId], references: [id], onDelete: Cascade)
  assignee            User?           @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  report              Report?         @relation(fields: [reportId], references: [id], onDelete: SetNull)
  votes               AuditVote[]

  @@index([issueId, status])
  @@index([assigneeId, status])
  @@index([status, dueAt])
  @@index([kind, status])
}

model AuditVote {
  id        String        @id @default(cuid())
  taskId    String
  userId    String
  observed  AuditObserved
  weight    Float
  createdAt DateTime      @default(now())

  task      AuditTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
}

model AuditorScore {
  id             String   @id @default(cuid())
  userId         String   @unique
  controlsPassed Int      @default(0)
  controlsTotal  Int      @default(0)
  reliability    Float    @default(0.6)
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
